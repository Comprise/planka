#!/usr/bin/env bash
# Подмена claude для тестов. Поведение задаёт PLANKA_STUB:
#   ok        — вердикт ok=true
#   deny      — ok=false, reason из PLANKA_STUB_REASON, violated ["Решения 4"]
#   hang      — не отвечает 100 с (exec: процесс заглушки и есть висящий процесс)
#   garbage   — не JSON
#   violated  — ok=false, violated из PLANKA_STUB_VIOLATED (сырой JSON)
#   nostructured — валидный JSON результата без structured_output
#   noOk      — structured_output без поля ok
#   unparsed  — строка, начинающаяся с «{», но не JSON
#   notlogged — is_error=true, "Not logged in"
# При PLANKA_STUB_RECORD=<файл> пишет туда аргументы, stdin, значение PLANKA_JUDGE, каталог и PID.
# python3 ответа — с PYTHONUTF8=1 и PYTHONIOENCODING=utf-8: аргументы и вывод в UTF-8, как у claude, в любой локали
# и кодировке вывода процесса тестов. Не-ASCII в ответе —
# без экранирования, как у JSON.stringify claude: U+2028, U+2029 и U+0085 остаются символами внутри строки.
if [ -n "${PLANKA_STUB_RECORD:-}" ]; then
  { printf 'ARGV\n'; printf '%s\n' "$@"; printf 'STDIN\n'; cat; printf 'ENV PLANKA_JUDGE=%s\n' "${PLANKA_JUDGE:-}"; printf 'CWD %s\n' "$(pwd -P)"; printf 'PID %s\n' "$$"; } > "$PLANKA_STUB_RECORD"
else
  cat > /dev/null
fi
case "${PLANKA_STUB:-ok}" in
  ok)
    printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"{\"ok\":true,\"violated\":[],\"reason\":\"\"}","structured_output":{"ok":true,"violated":[],"reason":""},"duration_ms":10}' ;;
  deny)
    R="${PLANKA_STUB_REASON:-в списке нет варианта, снимающего причину}"
    PYTHONUTF8=1 PYTHONIOENCODING=utf-8 python3 -c 'import json, sys; print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": "", "structured_output": {"ok": False, "violated": ["Решения 4"], "reason": sys.argv[1]}, "duration_ms": 10}, ensure_ascii=False))' "$R" ;;
  violated)
    PYTHONUTF8=1 PYTHONIOENCODING=utf-8 python3 -c 'import json, sys; print(json.dumps({"type": "result", "is_error": False, "result": "", "structured_output": {"ok": False, "violated": json.loads(sys.argv[1]), "reason": "r"}}, ensure_ascii=False))' "${PLANKA_STUB_VIOLATED:-[]}" ;;
  hang) exec sleep 100 ;;
  garbage) printf 'nonsense\n' ;;
  nostructured) printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"","duration_ms":10}' ;;
  noOk) printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"","structured_output":{"violated":[],"reason":"r"},"duration_ms":10}' ;;
  unparsed) printf '%s\n' '{oops' ;;
  notlogged)
    printf '%s\n' '{"type":"result","subtype":"success","is_error":true,"result":"Not logged in · Please run /login","duration_ms":1}' ;;
esac
